            document.getElementById(`page-${tabId}`).classList.add('active');
            
            // 更新底部导航状态
            document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
            const navItem = document.getElementById(`nav-${tabId}`);
            if(navItem) navItem.classList.add('active');

            // 特殊处理：如果切换到聊天页，滚动到底部
            if(tabId === 'chat') {
                const chatWin = document.getElementById('chat-window');
                chatWin.scrollTop = chatWin.scrollHeight;
            }
        }

        // 显示 Toast 提示
        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.textContent = msg;
            toast.style.display = 'block';
            setTimeout(() => {
                toast.style.display = 'none';
            }, 3000);
        }

        // ====================
        // 功能 1: AI 对话系统
        // ====================
        
        function toggleVoiceInput() {
            const btn = document.getElementById('voice-input-btn');
            const btnText = document.getElementById('voice-btn-text');

            if (!isListening) {
                // 开始模拟录音
                isListening = true;
                btn.classList.add('listening-anim');
                btnText.textContent = "正在聆听...";
                
                // 模拟 2秒后说话结束
                setTimeout(() => {
                    finishVoiceInput();
                }, 2000);
            } else {
                // 手动结束
                finishVoiceInput();
            }
        }

        function finishVoiceInput() {
            isListening = false;
            const btn = document.getElementById('voice-input-btn');
            const btnText = document.getElementById('voice-btn-text');
            btn.classList.remove('listening-anim');
            btnText.textContent = "按住 说话";

            // 模拟识别结果（随机）
            const inputs = ["今天天气不错", "我想去公园走走", "头有点晕怎么办", "谢谢你陪我聊天", "今天吃什么"];
            const randomInput = inputs[Math.floor(Math.random() * inputs.length)];
            
            addMessage(randomInput, 'user');
            
            // 模拟 AI 思考回复
            setTimeout(() => {
                const response = getAIResponse(randomInput);
                addMessage(response, 'ai');
                speak(response);
            }, 1000);
        }

        function addMessage(text, type) {
            const chatWin = document.getElementById('chat-window');
            const div = document.createElement('div');
            div.className = `message ${type}`;
            div.textContent = text;
            chatWin.appendChild(div);
            chatWin.scrollTop = chatWin.scrollHeight;
        }

        function getAIResponse(input) {
            input = input.toLowerCase();
            if (input.includes("头晕")) return "李大爷，头晕可能是血压有点波动。建议您先坐下来休息一会儿，喝点温水。如果感觉不舒服，要不要我帮您联系孩子或者去医院？";
            if (input.includes("公园") || input.includes("走走")) return "好主意！最近的'阳光湿地公园'环境很不错，适合散步。需要我为您导航过去吗？";
            if (input.includes("谢谢")) return "不客气，能陪您聊天我也很开心。有什么事随时叫我！";
            if (input.includes("吃")) return "到了饭点了呀。今天天气好，建议吃点清淡的，比如清蒸鱼和炒时蔬，对肠胃好。";
            return "嗯嗯，我在听呢。还有其他想告诉我的吗？或者是身体哪里不舒服？";
        }

        function speak(text) {
            const useTTS = document.getElementById('setting-tts').checked;
            if (!useTTS) return;

            // 取消之前的播报
            if(synth.speaking) synth.cancel();

            const utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = 'zh-CN';
            utterance.rate = 0.8; // 语速稍慢
            utterance.pitch = 1;
            synth.speak(utterance);
        }

        function clearHistory() {
            const chatWin = document.getElementById('chat-window');
            chatWin.innerHTML = '<div class="message ai">记录已清空。李大爷，咱们重新开始聊吧。</div>';
            closeSettings();
        }

        // ====================
