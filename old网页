                        </div>
                        <div class="tour-desc">${item.desc}</div>
                    </div>
                    <button class="btn btn-large" onclick="goToNav('${item.title}')">🧭 一键导航去这里</button>
                `;
                container.appendChild(card);
            });
        }

        function filterTourism(type, btn) {
