        // ====================

        function submitHealth() {
            const high = document.getElementById('bp-high').value;
            const low = document.getElementById('bp-low').value;
            const symptom = document.getElementById('symptom').value;

            if (!high || !low) {
                showToast("请您输入血压数值哦");
                return;
            }

            // 简单逻辑判断
            const resultDiv = document.getElementById('health-result');
            resultDiv.style.display = 'block';
            
            let statusText = "";
            let statusClass = "";
            let advice = "";

            if (high > 140 || low > 90 || symptom !== 'good') {
                statusClass = "status-warn";
                if(symptom === 'dizzy' || high > 160) {
                    statusClass = "status-bad";
                    statusText = "⚠️ 身体状况异常";
                    advice = "建议您卧床休息，并测量第二次。如果持续不适，请立即按下方红色按钮联系家属或就医。";
                    speak("李大爷，检测到数据有些异常，请不要紧张，先坐下休息，必要时联系家人。");
                } else {
                    statusText = "⚠️ 需要注意";
                    advice = "血压稍微有点高，注意清淡饮食，保持心情愉快。如有不适请及时就医。";
                    speak("李大爷，您的数据稍微有点偏高，平时记得少盐多运动哦。");
                }
            } else {
                statusClass = "status-good";
                statusText = "✅ 身体状况良好";
                advice = "您的身体很硬朗！继续保持适量运动和健康作息。";
                speak("李大爷，您的身体指标很健康，真棒！");
            }

            resultDiv.className = `health-status ${statusClass}`;
            resultDiv.innerHTML = `${statusText}<br><span style="font-size: 1rem; font-weight: normal; margin-top:10px; display:block;">${advice}</span>`;

            // 更新图表最后一个柱子 (模拟)
            const bars = document.querySelectorAll('.bar');
            const lastBar = bars[bars.length - 1];
            const heightPercent = Math.min(100, (high / 180) * 100);
            lastBar.style.height = `${heightPercent}%`;
            
            if(statusClass.includes('bad')) lastBar.style.backgroundColor = 'var(--danger-color)';
            else if(statusClass.includes('warn')) lastBar.style.backgroundColor = 'orange';
            else lastBar.style.backgroundColor = 'var(--primary-color)';

            showToast("数据已保存");
        }

        // ====================
        // 功能 3: 文旅推送
        // ====================

        function renderTourism(filterType) {
            const container = document.getElementById('tourism-list');
            container.innerHTML = "";

            const filtered = filterType === 'all' 
                ? mockTourismData 
                : mockTourismData.filter(item => item.type === filterType);

            filtered.forEach(item => {
                const card = document.createElement('div');
                card.className = 'card tour-card';
                card.innerHTML = `
                    <img src="https://picsum.photos/seed/${item.id}/400/200" class="tour-img" alt="${item.title}">
                    <div class="tour-info">
                        <h3>${item.title}</h3>
                        <div class="tour-tags">
